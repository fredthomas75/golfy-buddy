# Copy this file to `.env` (gitignored) for local development.
# NEVER put real secrets in `.env.example` — this file is committed.

# --- Database ---
# Local dev/test use config/database.yml (GOLFY-BUDDY_development / _test).
# To run against Supabase locally, set DATABASE_URL to the POOLER url (port 6543):
# DATABASE_URL=postgres://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations use the DIRECT connection (port 5432):
# MIGRATE_DATABASE_URL=postgres://USER:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require

# --- Rails ---
# Locally the master key is read from config/master.key.
# On the host (Render), set it as an env var instead:
# RAILS_MASTER_KEY=

# --- Maps (Mapbox) ---
MAPBOX_API_KEY=

# --- Image hosting (Cloudinary) ---
# Either a single URL...
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or the individual vars:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
