.bundle
log/*.log
tmp/**/*
tmp/*
!log/.keep
!tmp/.keep
*.swp
.DS_Store
public/assets
/public/uploads
public/packs
public/packs-test
node_modules

# esbuild / jsbundling output (built during assets:precompile)
/app/assets/builds/*
!/app/assets/builds/.keep
yarn-error.log
.byebug_history
.env*
!.env.example

# Never commit the Rails master key — production decrypts via the RAILS_MASTER_KEY env var
/config/master.key
